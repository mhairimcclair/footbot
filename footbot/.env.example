FOOTBALL_DATA_TOKEN=your_token_here
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_APP_TOKEN=xapp-your-token-here
SLACK_CHANNEL=C0000000000

# Set to "paid" after upgrading your football-data.org subscription.
# paid: 30 req/min, 30s poll interval. free (default): 10 req/min, 60s.
FOOTBALL_DATA_TIER=free

# Time (UTC) to post the end-of-day matchday summary. Default 05:00 covers
# late West Coast (Pacific) kick-offs for WC2026 in the Americas.
MATCHDAY_SUMMARY_HOUR=5
MATCHDAY_SUMMARY_MINUTE=0
